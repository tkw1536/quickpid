    {
      "name": "autocomplete_prefix",
      "config": {},
      "limits": {
        "MaxAutocompleteUsers": 10
      },
      "request": {
        "method": "GET",
        "path": "/users/autocomplete?query=al",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": [
