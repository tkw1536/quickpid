{
  "name": "235_resource_patch_tags_one_item",
  "comment": "PATCH with a one-element tags array replaces resource tags and returns that tags array.",
  "steps": [
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "46c14e5d-c048-4159-a26a-f37bc0110c85"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[\"update-res\"],\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201
      }
    },
    {
      "name": "create_resource",
      "config": {
        "pids": [
          "xjc-cjy"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources",
        "body": "{\"url\":\"https://example.com/a\",\"metadata\":\"ext-1@sys-a\",\"tags\":[\"alpha\"]}"
      },
      "response": {
        "code": 201
      }
    },
    {
      "name": "tagsOneItem",
      "config": {
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "PATCH",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources/xjc-cjy",
        "body": "{\"tags\":[\"only\"]}"
      },
      "response": {
        "code": 200,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "deleted": false,
          "metadata": "ext-1@sys-a",
          "pid": "xjc-cjy",
          "tags": [
            "only"
          ],
          "url": "https://example.com/a"
        }
      }
    }
  ]
}
