{
  "name": "261_mount_list_auth",
  "comment": "In authenticated mode, listing all mounts requires superuser; listing mounts for a namespace requires at least contributor.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice",
          "password": false
        }
      }
    },
    {
      "name": "create_bob",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"bob\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "bob",
          "password": false
        }
      }
    },
    {
      "name": "issue_alice_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "alice-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"alice\",\"expiresAt\": null,\"userScopes\":[],\"namespaceScopes\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "alice"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "alice",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "alice-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice",
          "userScopes": [],
          "namespaceScopes": []
        }
      }
    },
    {
      "name": "issue_bob_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bob-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaabob"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"bob\",\"expiresAt\": null,\"userScopes\":[],\"namespaceScopes\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "bob"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "bob",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "bob-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaabob",
          "userScopes": [],
          "namespaceScopes": []
        }
      }
    },
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "ns-list-auth"
        ],
        "now": "2026-07-05T12:00:00Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[\"list-auth\"],\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2026-07-05T12:00:00Z",
          "dateUpdated": "2026-07-05T12:00:00Z",
          "id": "ns-list-auth",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "list-auth"
          ]
        }
      }
    },
    {
      "name": "grant_alice_contributor",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/namespaces/ns-list-auth/roles/alice",
        "body": "{\"role\":\"contributor\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "username": "alice",
          "role": "contributor"
        }
      }
    },
    {
      "name": "put_mount",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/mounts/https%3A%2F%2Flist.example.com%2F",
        "body": "{\"namespace\":\"ns-list-auth\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "baseUri": "https://list.example.com/",
          "namespace": "ns-list-auth"
        }
      }
    },
    {
      "name": "list_all_unauthorized",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/mounts"
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    },
    {
      "name": "list_all_forbidden",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/mounts",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 403,
        "body": {
          "error": "forbidden"
        }
      }
    },
    {
      "name": "list_all_superuser",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/mounts?limit=100",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "total": 1,
          "offset": 0,
          "items": [
            {
              "baseUri": "https://list.example.com/",
              "namespace": "ns-list-auth"
            }
          ]
        }
      }
    },
    {
      "name": "list_ns_forbidden_outsider",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/ns-list-auth/mounts",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaabob"
          ]
        ]
      },
      "response": {
        "code": 403,
        "body": {
          "error": "forbidden"
        }
      }
    },
    {
      "name": "list_ns_contributor",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/ns-list-auth/mounts?limit=100",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "total": 1,
          "offset": 0,
          "items": [
            "https://list.example.com/"
          ]
        }
      }
    }
  ]
}
