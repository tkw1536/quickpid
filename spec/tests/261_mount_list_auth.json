{
  "name": "261_mount_list_auth",
  "comment": "In authenticated mode, listing all mounts requires superuser; listing mounts for a namespace requires at least contributor.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice",
          "password": false
        }
      }
    },
    {
      "name": "create_bob",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"bob\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "bob",
          "password": false
        }
      }
    },
    {
      "name": "issue_alice_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "alice-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=alice",
        "body": "{\"comment\": \"alice\",\"expires_at\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "alice",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "alice-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        }
      }
    },
    {
      "name": "issue_bob_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bob-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaabob"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=bob",
        "body": "{\"comment\": \"bob\",\"expires_at\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "bob",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "bob-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaabob"
        }
      }
    },
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "ns-list-auth"
        ],
        "now": "2026-07-05T12:00:00Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"list-auth\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2026-07-05T12:00:00Z",
          "id": "ns-list-auth",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "list-auth"
        }
      }
    },
    {
      "name": "grant_alice_contributor",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/namespaces/ns-list-auth/roles/alice",
        "body": "{\"role\":\"contributor\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "username": "alice",
          "role": "contributor"
        }
      }
    },
    {
      "name": "put_mount",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/mounts/https%3A%2F%2Flist.example.com%2F",
        "body": "{\"namespace\":\"ns-list-auth\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "base_uri": "https://list.example.com/",
          "namespace": "ns-list-auth"
        }
      }
    },
    {
      "name": "list_all_unauthorized",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/mounts"
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    },
    {
      "name": "list_all_forbidden",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/mounts",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 403,
        "body": {
          "error": "forbidden"
        }
      }
    },
    {
      "name": "list_all_superuser",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/mounts?limit=100",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "total": 1,
          "offset": 0,
          "items": [
            {
              "base_uri": "https://list.example.com/",
              "namespace": "ns-list-auth"
            }
          ]
        }
      }
    },
    {
      "name": "list_ns_forbidden_outsider",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/ns-list-auth/mounts",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaabob"
          ]
        ]
      },
      "response": {
        "code": 403,
        "body": {
          "error": "forbidden"
        }
      }
    },
    {
      "name": "list_ns_contributor",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/ns-list-auth/mounts?limit=100",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "total": 1,
          "offset": 0,
          "items": [
            "https://list.example.com/"
          ]
        }
      }
    }
  ]
}
