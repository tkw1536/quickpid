{
  "name": "72_resource_batch_create_post_body_too_large",
  "comment": "A batch request body exceeding max_body_bytes returns 413 body_size_exceeded.",
  "steps": [
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "46c14e5d-c048-4159-a26a-f37bc0110c85"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"batch-res\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "46c14e5d-c048-4159-a26a-f37bc0110c85",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "batch-res"
        }
      }
    },
    {
      "name": "tooLargeBody",
      "config": {
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "limits": {
        "MaxBodyBytes": 256,
        "DefaultPageLimit": 0,
        "MaxPageLimit": 0,
        "MaxBatchItems": 0,
        "MaxNamespaceIDAttempts": 0,
        "MaxPIDAttempts": 0
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources:batch",
        "body": "[{\"url\":\"https:\",\"metadata\":\"x\",\"tag\":\"\"}]"
      },
      "response": {
        "code": 413,
        "body": {
          "error": "body_size_exceeded"
        }
      }
    }
  ]
}
