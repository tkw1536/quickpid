{
  "name": "auth_user_key_post_scopes_invalid_namespace",
  "comment": "Issuing a key rejects invalid namespace ids, unknown scopes, and namespaces that do not exist.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "invalid_namespace_id",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"bad-ns\",\"expiresAt\":null,\"userScopes\":[],\"namespaceScopes\":[{\"namespace\":\"BAD!\",\"scope\":\"getResource\"}]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalidNamespaceId"
        }
      }
    },
    {
      "name": "unknown_scope",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"bad-scope\",\"expiresAt\":null,\"userScopes\":[\"notARealScope\"],\"namespaceScopes\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 400,
        "body": {
          "error": "unknownScope"
        }
      }
    },
    {
      "name": "namespace_not_found",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"missing-ns\",\"expiresAt\":null,\"userScopes\":[],\"namespaceScopes\":[{\"namespace\":\"does-not-exist\",\"scope\":\"getResource\"}]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 404,
        "body": {
          "error": "namespaceNotFound"
        }
      }
    }
  ]
}
