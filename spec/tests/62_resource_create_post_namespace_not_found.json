{
  "name": "62_resource_create_post_namespace_not_found",
  "comment": "POST /resolver/namespaces/{namespace}/resources returns 404 when the namespace does not exist.",
  "steps": [
    {
      "name": "namespaceMissing",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/absent-ns/resources",
        "body": "{\"url\":\"https://x\",\"metadata\":null,\"tags\":[\"\"]}"
      },
      "response": {
        "code": 404,
        "body": {
          "error": "namespace_not_found"
        }
      }
    }
  ]
}
