          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "res-ns"
        }
      }
    },
    {
      "name": "create_resource",
      "config": {
        "pids": [
          "xjc-cjy"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
