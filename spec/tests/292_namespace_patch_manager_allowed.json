{
  "name": "292_namespace_patch_manager_allowed",
  "comment": "A namespace manager can PATCH the namespace tags in authenticated mode, while an editor cannot.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_owner",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"owner\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "owner",
          "password": false
        }
      }
    },
    {
      "name": "create_editor",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"editor\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "editor",
          "password": false
        }
      }
    },
    {
      "name": "issue_owner_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "owner-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"owner\",\"expiresAt\":null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "owner"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "owner",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "owner-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
        }
      }
    },
    {
      "name": "issue_editor_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "editor-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaeditor"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"editor\",\"expiresAt\":null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "editor"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "editor",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "editor-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaeditor"
        }
      }
    },
    {
      "name": "owner_creates_namespace",
      "config": {
        "namespaceIDs": [
          "d1000000-0000-4000-8000-000000000002"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[\"owner-tag\"],\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "d1000000-0000-4000-8000-000000000002",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "owner-tag"
          ]
        }
      }
    },
    {
      "name": "grant_editor",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/namespaces/d1000000-0000-4000-8000-000000000002/roles/editor",
        "body": "{\"role\":\"editor\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "role": "editor",
          "username": "editor"
        }
      }
    },
    {
      "name": "editor_patch_forbidden",
      "config": {
        "now": "2020-01-02T03:05:05Z"
      },
      "request": {
        "method": "PATCH",
        "path": "/resolver/namespaces/d1000000-0000-4000-8000-000000000002",
        "body": "{\"tags\":[\"editor-updated\"]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaeditor"
          ]
        ]
      },
      "response": {
        "code": 403,
        "body": {
          "error": "forbidden"
        }
      }
    },
    {
      "name": "owner_patches_namespace",
      "config": {
        "now": "2020-01-02T03:05:06Z"
      },
      "request": {
        "method": "PATCH",
        "path": "/resolver/namespaces/d1000000-0000-4000-8000-000000000002",
        "body": "{\"tags\":[\"manager-updated\"]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:05:06Z",
          "id": "d1000000-0000-4000-8000-000000000002",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "manager-updated"
          ]
        }
      }
    },
    {
      "name": "owner_gets_namespace",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/d1000000-0000-4000-8000-000000000002",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:05:06Z",
          "id": "d1000000-0000-4000-8000-000000000002",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "manager-updated"
          ]
        }
      }
    }
  ]
}
