{
  "name": "anonymous_user_key_post_unavailable",
  "comment": "In anonymous mode, POST /user/key returns 404 unavailable_in_anonymous_mode.",
  "steps": [
    {
      "name": "post_disabled",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"k\",\"expires_at\":null}"
      },
      "response": {
        "code": 404,
        "body": {
          "error": "unavailable_in_anonymous_mode"
        }
      }
    }
  ]
}
