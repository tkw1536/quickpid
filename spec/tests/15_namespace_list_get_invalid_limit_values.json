{
  "name": "15_namespace_list_get_invalid_limit_values",
  "comment": "Negative or non-integer limit values on GET /resolver/namespaces return 400 invalidQueryParameter.",
  "steps": [
    {
      "name": "invalidQuery_limit_-1",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces?limit=-1"
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalidQueryParameter"
        }
      }
    },
    {
      "name": "invalidQuery_limit_abc",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces?limit=abc"
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalidQueryParameter"
        }
      }
    }
  ]
}
