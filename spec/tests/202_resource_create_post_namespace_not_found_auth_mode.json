{
  "name": "resource_create_post_namespace_not_found_auth_mode",
  "comment": "Resource create in authenticated mode against an unknown namespace returns 404 namespace_not_found.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root"
        }
      }
    },
    {
      "name": "issue_root_key2",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "root-key-2"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaroot2"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"root\", \"expires_at\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "root",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "root-key-2",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaroot2"
        }
      }
    },
    {
      "name": "missing_ns",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/absent-ns/resources",
        "body": "{\"url\":\"https://x\",\"metadata\":null,\"tag\":\"\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 404,
        "body": {
          "error": "namespace_not_found"
        }
      }
    }
  ]
}
