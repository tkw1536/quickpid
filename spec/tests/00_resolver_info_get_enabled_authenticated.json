{
  "name": "00_resolver_info_get_enabled_authenticated",
  "comment": "When the resolver info endpoint is enabled in authenticated mode, GET /resolver returns limits and indicates that API-key authentication is required.",
  "steps": [
    {
      "name": "info_ok_auth",
      "config": {
        "infoEnabled": true
      },
      "limits": {
        "MaxBodyBytes": 1048576,
        "DefaultPageLimit": 100,
        "MaxPageLimit": 1000,
        "MaxBatchItems": 100,
        "maxAutocompleteUsers": 10,
        "MaxNamespaceIDAttempts": 100,
        "MaxPIDAttempts": 100
      },
      "request": {
        "method": "GET",
        "path": "/resolver"
      },
      "response": {
        "code": 200,
        "body": {
          "authentication": true,
          "defaultPageLimit": 100,
          "maxAutocompleteUsers": 10,
          "maxBatchItems": 100,
          "maxBodyBytes": 1048576,
          "maxPageLimit": 1000
        }
      }
    }
  ]
}
