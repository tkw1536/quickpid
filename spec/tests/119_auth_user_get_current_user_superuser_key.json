{
  "name": "119_auth_user_get_current_user_superuser_key",
  "comment": "An issued superuser API key authenticates correctly on GET /user/.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root"
        }
      }
    },
    {
      "name": "create_servertest",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"servertest\",\"superuser\":true}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": true,
          "username": "servertest"
        }
      }
    },
    {
      "name": "issue_servertest_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "servertest-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaservertest"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=servertest",
        "body": "{\"comment\": \"servertest\",\"expires_at\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "servertest",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "servertest-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaservertest"
        }
      }
    },
    {
      "name": "verify_servertest_key",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaservertest"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "servertest"
        }
      }
    }
  ]
}
