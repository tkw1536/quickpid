{
  "name": "auth_user_key_empty_other_scopes_denied",
  "comment": "When one of userScopes or namespaceScopes is non-empty, an empty list of the other type grants no scopes of that type: a user-only key cannot get a resource, and a namespace-only key cannot get user info.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_ns_a",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "namespaceIDs": [
          "ns-a"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[],\"pidFormat\":{\"pattern\":\"***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2026-07-05T12:00:00Z",
          "dateUpdated": "2026-07-05T12:00:00Z",
          "id": "ns-a",
          "pidFormat": {
            "characters": "full",
            "pattern": "***"
          },
          "tags": []
        }
      }
    },
    {
      "name": "create_resource_ns_a",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "pids": [
          "aaa"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/ns-a/resources",
        "body": "{\"url\":\"https://example.com/a\",\"metadata\":null,\"tags\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2026-07-05T12:00:00Z",
          "dateUpdated": "2026-07-05T12:00:00Z",
          "deleted": false,
          "metadata": null,
          "pid": "aaa",
          "url": "https://example.com/a",
          "tags": []
        }
      }
    },
    {
      "name": "issue_user_only_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "scoped-user-only"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaauser"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"user-only\",\"expiresAt\":null,\"userScopes\":[\"getUserInfo\"],\"namespaceScopes\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "user-only",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "scoped-user-only",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaauser",
          "userScopes": [
            "getUserInfo"
          ],
          "namespaceScopes": []
        }
      }
    },
    {
      "name": "user_only_get_resource_unauthorized",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/ns-a/resources/aaa",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaauser"
          ]
        ]
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    },
    {
      "name": "issue_namespace_only_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "scoped-ns-only"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaansone"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"ns-only\",\"expiresAt\":null,\"userScopes\":[],\"namespaceScopes\":[{\"namespace\":\"ns-a\",\"scope\":\"getResource\"}]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "ns-only",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "scoped-ns-only",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaansone",
          "userScopes": [],
          "namespaceScopes": [
            {
              "namespace": "ns-a",
              "scope": "getResource"
            }
          ]
        }
      }
    },
    {
      "name": "namespace_only_get_user_unauthorized",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaansone"
          ]
        ]
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    }
  ]
}
