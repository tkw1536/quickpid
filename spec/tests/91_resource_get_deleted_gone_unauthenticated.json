{
  "name": "resource_get_deleted_gone_unauthenticated",
  "comment": "In authenticated mode, an unauthenticated GET for a soft-deleted resource returns 410 resource_gone without resource data.",
  "steps": [
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "46c14e5d-c048-4159-a26a-f37bc0110c85"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"res-ns\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "46c14e5d-c048-4159-a26a-f37bc0110c85",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "res-ns"
        }
      }
    },
    {
      "name": "create_resource",
      "config": {
        "pids": [
          "xjc-cjy"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources",
        "body": "{\"url\":\"https://example.com/r\",\"metadata\":\"m\",\"tag\":\"t\"}"
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "date_updated": "2020-01-02T03:04:05Z",
          "deleted": false,
          "metadata": "m",
          "pid": "xjc-cjy",
          "tag": "t",
          "url": "https://example.com/r"
        }
      }
    },
    {
      "name": "mark_deleted",
      "config": {
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "PATCH",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources/xjc-cjy",
        "body": "{\"deleted\":true}"
      },
      "response": {
        "code": 200,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "date_updated": "2020-01-02T03:04:05Z",
          "deleted": true,
          "metadata": "m",
          "pid": "xjc-cjy",
          "tag": "t",
          "url": "https://example.com/r"
        }
      }
    },
    {
      "name": "get_deleted_unauthenticated",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources/xjc-cjy"
      },
      "response": {
        "code": 410,
        "body": {
          "error": "resource_gone"
        }
      }
    }
  ]
}
