{
  "name": "276_auth_user_key_get_excludes_expired",
  "comment": "GET /user/key omits expired API keys from total and items, while still-valid keys remain listed.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\": \"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice",
          "password": false
        }
      }
    },
    {
      "name": "issue_alice_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "alice-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=alice",
        "body": "{\"comment\": \"alice\", \"expiresAt\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "alice",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "alice-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        }
      }
    },
    {
      "name": "issue_temp_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "temp-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaatemp"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"temp\", \"expiresAt\": \"2026-07-06T12:00:00Z\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "temp",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": "2026-07-06T12:00:00Z",
          "id": "temp-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaatemp"
        }
      }
    },
    {
      "name": "list_before_expiry",
      "config": {
        "now": "2026-07-05T12:00:00Z"
      },
      "request": {
        "method": "GET",
        "path": "/user/key",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "offset": 0,
          "total": 2,
          "items": [
            {
              "comment": "alice",
              "createdAt": "2026-07-05T12:00:00Z",
              "expiresAt": null,
              "id": "alice-key"
            },
            {
              "comment": "temp",
              "createdAt": "2026-07-05T12:00:00Z",
              "expiresAt": "2026-07-06T12:00:00Z",
              "id": "temp-key"
            }
          ]
        }
      }
    },
    {
      "name": "list_after_expiry",
      "config": {
        "now": "2026-07-07T12:00:00Z"
      },
      "request": {
        "method": "GET",
        "path": "/user/key",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "offset": 0,
          "total": 1,
          "items": [
            {
              "comment": "alice",
              "createdAt": "2026-07-05T12:00:00Z",
              "expiresAt": null,
              "id": "alice-key"
            }
          ]
        }
      }
    }
  ]
}
