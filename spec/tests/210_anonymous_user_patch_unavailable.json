{
  "name": "anonymous_user_patch_unavailable",
  "comment": "In anonymous mode, PATCH /user returns 404 unavailable_in_anonymous_mode.",
  "steps": [
    {
      "name": "patch_disabled",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "PATCH",
        "path": "/user?username=alice",
        "body": "{}"
      },
      "response": {
        "code": 404,
        "body": {
          "error": "unavailable_in_anonymous_mode"
        }
      }
    }
  ]
}
