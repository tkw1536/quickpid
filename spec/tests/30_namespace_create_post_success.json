{
  "name": "30_namespace_create_post_success",
  "comment": "POST /resolver/namespaces with a valid body creates a namespace and returns 201 with the server-assigned id.",
  "steps": [
    {
      "name": "success",
      "config": {
        "namespaceIDs": [
          "fake-namespace-id"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"flow-tag\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "fake-namespace-id",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "flow-tag"
        }
      }
    }
  ]
}
