{
  "name": "26_namespace_get_superuser_allowed",
  "comment": "Superusers can retrieve any existing namespace by id.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_admin",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"admin\",\"superuser\":true}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": true,
          "username": "admin",
          "password": false
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice",
          "password": false
        }
      }
    },
    {
      "name": "issue_admin_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "admin-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaadmin"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=admin",
        "body": "{\"comment\": \"admin\",\"expires_at\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "admin",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "admin-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaadmin"
        }
      }
    },
    {
      "name": "create_ns_a",
      "config": {
        "namespaceIDs": [
          "a1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"ns-a\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "a1000000-0000-4000-8000-000000000001",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "ns-a"
        }
      }
    },
    {
      "name": "create_ns_b",
      "config": {
        "namespaceIDs": [
          "b1000000-0000-4000-8000-000000000002"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"ns-b\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "b1000000-0000-4000-8000-000000000002",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "ns-b"
        }
      }
    },
    {
      "name": "grant_admin_ns_a",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/namespaces/a1000000-0000-4000-8000-000000000001/roles/admin",
        "body": "{\"role\":\"manager\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "role": "manager",
          "username": "admin"
        }
      }
    },
    {
      "name": "grant_alice_ns_b",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/namespaces/b1000000-0000-4000-8000-000000000002/roles/alice",
        "body": "{\"role\":\"contributor\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "role": "contributor",
          "username": "alice"
        }
      }
    },
    {
      "name": "get_ns_a_as_admin",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/a1000000-0000-4000-8000-000000000001",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaadmin"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "a1000000-0000-4000-8000-000000000001",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "ns-a"
        }
      }
    }
  ]
}
