{
  "name": "auth_user_key_namespace_scopes_enforced",
  "comment": "A non-empty namespaceScopes list is enforced at runtime: the granted (namespace, scope) pair succeeds; other namespaces or scopes return 401 unauthorized (even for a superuser).",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_ns_a",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "namespaceIDs": [
          "ns-a"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[],\"pidFormat\":{\"pattern\":\"***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2026-07-05T12:00:00Z",
          "dateUpdated": "2026-07-05T12:00:00Z",
          "id": "ns-a",
          "pidFormat": {
            "characters": "full",
            "pattern": "***"
          },
          "tags": []
        }
      }
    },
    {
      "name": "create_ns_b",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "namespaceIDs": [
          "ns-b"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[],\"pidFormat\":{\"pattern\":\"***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2026-07-05T12:00:00Z",
          "dateUpdated": "2026-07-05T12:00:00Z",
          "id": "ns-b",
          "pidFormat": {
            "characters": "full",
            "pattern": "***"
          },
          "tags": []
        }
      }
    },
    {
      "name": "create_resource_ns_a",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "pids": [
          "aaa"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/ns-a/resources",
        "body": "{\"url\":\"https://example.com/a\",\"metadata\":null,\"tags\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2026-07-05T12:00:00Z",
          "dateUpdated": "2026-07-05T12:00:00Z",
          "deleted": false,
          "metadata": null,
          "pid": "aaa",
          "url": "https://example.com/a",
          "tags": []
        }
      }
    },
    {
      "name": "create_resource_ns_b",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "pids": [
          "bbb"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/ns-b/resources",
        "body": "{\"url\":\"https://example.com/b\",\"metadata\":null,\"tags\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2026-07-05T12:00:00Z",
          "dateUpdated": "2026-07-05T12:00:00Z",
          "deleted": false,
          "metadata": null,
          "pid": "bbb",
          "url": "https://example.com/b",
          "tags": []
        }
      }
    },
    {
      "name": "issue_ns_scoped_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "scoped-ns-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaanskey"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"ns-scoped\",\"expiresAt\":null,\"userScopes\":[],\"namespaceScopes\":[{\"namespace\":\"ns-a\",\"scope\":\"getResource\"}]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "ns-scoped",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "scoped-ns-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaanskey",
          "userScopes": [],
          "namespaceScopes": [
            {
              "namespace": "ns-a",
              "scope": "getResource"
            }
          ]
        }
      }
    },
    {
      "name": "granted_get_resource_ns_a",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/ns-a/resources/aaa",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaanskey"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "dateCreated": "2026-07-05T12:00:00Z",
          "dateUpdated": "2026-07-05T12:00:00Z",
          "deleted": false,
          "metadata": null,
          "pid": "aaa",
          "url": "https://example.com/a",
          "tags": []
        }
      }
    },
    {
      "name": "wrong_namespace_get_resource_unauthorized",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/ns-b/resources/bbb",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaanskey"
          ]
        ]
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    },
    {
      "name": "wrong_scope_create_resource_unauthorized",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/ns-a/resources",
        "body": "{\"url\":\"https://example.com/c\",\"metadata\":null,\"tags\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaanskey"
          ]
        ]
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    }
  ]
}
