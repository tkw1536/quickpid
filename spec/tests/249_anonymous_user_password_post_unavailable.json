{
  "name": "anonymous_user_password_post_unavailable",
  "comment": "In anonymous mode, POST /user/password returns 404 unavailable_in_anonymous_mode.",
  "steps": [
    {
      "name": "set_disabled",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/user/password",
        "body": "{\"password\":\"secret\"}"
      },
      "response": {
        "code": 404,
        "body": {
          "error": "unavailable_in_anonymous_mode"
        }
      }
    }
  ]
}
