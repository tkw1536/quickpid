{
  "name": "21_namespace_list_get_tag_filter_with_no_matching_permissions",
  "comment": "Tag filtering is applied after permission filtering, so a user may see an empty list even when namespaces with that tag exist.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_admin",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"admin\",\"superuser\":true}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": true,
          "username": "admin",
          "password": false
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice",
          "password": false
        }
      }
    },
    {
      "name": "issue_admin_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "admin-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaadmin"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=admin",
        "body": "{\"comment\": \"admin\",\"expires_at\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "admin",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "admin-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaadmin"
        }
      }
    },
    {
      "name": "issue_alice_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "alice-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=alice",
        "body": "{\"comment\": \"alice\",\"expires_at\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "alice",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "alice-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        }
      }
    },
    {
      "name": "create_ns_a",
      "config": {
        "namespaceIDs": [
          "a1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"ns-a\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "a1000000-0000-4000-8000-000000000001",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "ns-a"
        }
      }
    },
    {
      "name": "create_ns_b",
      "config": {
        "namespaceIDs": [
          "b1000000-0000-4000-8000-000000000002"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"ns-b\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "b1000000-0000-4000-8000-000000000002",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "ns-b"
        }
      }
    },
    {
      "name": "grant_admin_ns_a",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/namespaces/a1000000-0000-4000-8000-000000000001/permissions/admin",
        "body": "{\"level\":\"manager\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "level": "manager",
          "username": "admin"
        }
      }
    },
    {
      "name": "grant_alice_ns_b",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/namespaces/b1000000-0000-4000-8000-000000000002/permissions/alice",
        "body": "{\"level\":\"contributor\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "level": "contributor",
          "username": "alice"
        }
      }
    },
    {
      "name": "list_as_alice_tag_ns_a",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces?tag=ns-a",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "items": [],
          "offset": 0,
          "total": 0
        }
      }
    }
  ]
}
