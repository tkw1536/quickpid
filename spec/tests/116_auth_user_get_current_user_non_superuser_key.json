{
  "name": "116_auth_user_get_current_user_non_superuser_key",
  "comment": "An issued API key authenticates as the corresponding non-superuser on GET /user/.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root"
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice"
        }
      }
    },
    {
      "name": "issue_alice_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "alice-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=alice",
        "body": "{\"comment\": \"alice\",\"expires_at\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "alice",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "alice-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        }
      }
    },
    {
      "name": "verify_alice_key",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": false,
          "username": "alice"
        }
      }
    }
  ]
}
