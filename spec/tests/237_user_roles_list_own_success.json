{
  "name": "237_user_roles_list_own_success",
  "comment": "A user can list their own explicit roles across namespaces, sorted by namespace id.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_owner",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"owner\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "owner",
          "password": false
        }
      }
    },
    {
      "name": "issue_owner_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "owner-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=owner",
        "body": "{\"comment\": \"owner\",\"expires_at\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "owner",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "owner-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
        }
      }
    },
    {
      "name": "owner_creates_ns_b",
      "config": {
        "namespaceIDs": [
          "b1000000-0000-4000-8000-000000000002"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"ns-b\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "b1000000-0000-4000-8000-000000000002",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "ns-b"
        }
      }
    },
    {
      "name": "owner_creates_ns_a",
      "config": {
        "namespaceIDs": [
          "a1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:06Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"ns-a\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:06Z",
          "id": "a1000000-0000-4000-8000-000000000001",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "ns-a"
        }
      }
    },
    {
      "name": "owner_lists_own_roles",
      "config": {},
      "limits": {
        "MaxBodyBytes": 1048576,
        "DefaultPageLimit": 100,
        "MaxPageLimit": 1000,
        "MaxBatchItems": 100,
        "MaxNamespaceIDAttempts": 100,
        "MaxPIDAttempts": 100
      },
      "request": {
        "method": "GET",
        "path": "/user/roles",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "items": [
            {
              "role": "manager",
              "namespace": "a1000000-0000-4000-8000-000000000001"
            },
            {
              "role": "manager",
              "namespace": "b1000000-0000-4000-8000-000000000002"
            }
          ],
          "offset": 0,
          "total": 2
        }
      }
    }
  ]
}
