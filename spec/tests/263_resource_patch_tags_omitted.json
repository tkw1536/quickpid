{
  "name": "263_resource_patch_tags_omitted",
  "comment": "PATCH that omits tags leaves the existing resource tags unchanged.",
  "steps": [
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "46c14e5d-c048-4159-a26a-f37bc0110c85"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"update-res\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201
      }
    },
    {
      "name": "create_resource",
      "config": {
        "pids": [
          "xjc-cjy"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources",
        "body": "{\"url\":\"https://example.com/a\",\"metadata\":\"ext-1@sys-a\",\"tags\":[\"alpha\",\"beta\"]}"
      },
      "response": {
        "code": 201
      }
    },
    {
      "name": "omitTags",
      "config": {
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "PATCH",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources/xjc-cjy",
        "body": "{\"url\":\"https://example.com/updated\"}"
      },
      "response": {
        "code": 200,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "date_updated": "2020-01-02T03:04:05Z",
          "deleted": false,
          "metadata": "ext-1@sys-a",
          "pid": "xjc-cjy",
          "tags": [
            "alpha",
            "beta"
          ],
          "url": "https://example.com/updated"
        }
      }
    }
  ]
}
