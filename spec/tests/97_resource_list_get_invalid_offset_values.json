{
  "name": "resource_list_get_invalid_offset_values",
  "comment": "Invalid offset values on resource listing return 400 invalid_query_parameter.",
  "steps": [
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "46c14e5d-c048-4159-a26a-f37bc0110c85"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"res-ns\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "46c14e5d-c048-4159-a26a-f37bc0110c85",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "res-ns"
        }
      }
    },
    {
      "name": "offset_negative",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources?offset=-1"
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalid_query_parameter"
        }
      }
    },
    {
      "name": "offset_non_integer",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources?offset=abc"
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalid_query_parameter"
        }
      }
    }
  ]
}
