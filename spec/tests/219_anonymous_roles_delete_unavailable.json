{
  "name": "anonymous_roles_delete_unavailable",
  "comment": "In anonymous mode, DELETE namespace role returns 404 unavailable_in_anonymous_mode.",
  "steps": [
    {
      "name": "create_namespace_anonymous",
      "config": {
        "anonymous": true,
        "namespaceIDs": [
          "d1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"anon-ns\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "id": "d1000000-0000-4000-8000-000000000001",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "anon-ns"
        }
      }
    },
    {
      "name": "delete_role_anonymous_unavailable",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "DELETE",
        "path": "/resolver/namespaces/c1000000-0000-4000-8000-000000000001/roles/reader"
      },
      "response": {
        "code": 404,
        "body": {
          "error": "unavailable_in_anonymous_mode"
        }
      }
    }
  ]
}
