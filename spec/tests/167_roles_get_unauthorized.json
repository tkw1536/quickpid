{
  "name": "roles_get_unauthorized",
  "comment": "GET namespace role without authentication returns 401 unauthorized.",
  "steps": [
    {
      "name": "create_ns_anon",
      "config": {
        "anonymous": true,
        "namespaceIDs": [
          "c1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"p\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "c1000000-0000-4000-8000-000000000001",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "p"
        }
      }
    },
    {
      "name": "get_unauthenticated",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/c1000000-0000-4000-8000-000000000001/roles/owner"
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    }
  ]
}
