{
  "name": "anonymous_permissions_get_unavailable",
  "comment": "In anonymous mode, GET namespace permission returns 404 unavailable_in_anonymous_mode.",
  "steps": [
    {
      "name": "create_namespace_anonymous",
      "config": {
        "anonymous": true,
        "namespaceIDs": [
          "d1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"anon-ns\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "d1000000-0000-4000-8000-000000000001",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "anon-ns"
        }
      }
    },
    {
      "name": "get_permission_disabled",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/d1000000-0000-4000-8000-000000000001/permissions/owner"
      },
      "response": {
        "code": 404,
        "body": {
          "error": "unavailable_in_anonymous_mode"
        }
      }
    }
  ]
}
