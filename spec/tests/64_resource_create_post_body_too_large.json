{
  "name": "64_resource_create_post_body_too_large",
  "comment": "A request body exceeding maxBodyBytes on resource create returns 413 bodySizeExceeded.",
  "steps": [
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "46c14e5d-c048-4159-a26a-f37bc0110c85"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"create-res\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "46c14e5d-c048-4159-a26a-f37bc0110c85",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "create-res"
        }
      }
    },
    {
      "name": "tooLargeBody",
      "config": {
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "limits": {
        "MaxBodyBytes": 256,
        "DefaultPageLimit": 0,
        "MaxPageLimit": 0,
        "MaxBatchItems": 0,
        "MaxNamespaceIDAttempts": 0,
        "MaxPIDAttempts": 0
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources",
        "body": "{\"url\":\"https:\",\"metadata\":\"x\",\"tags\":[\"z\"]}"
      },
      "response": {
        "code": 413,
        "body": {
          "error": "bodySizeExceeded"
        }
      }
    }
  ]
}
