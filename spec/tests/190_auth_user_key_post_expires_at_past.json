{
  "name": "auth_user_key_post_expiresAt_past",
  "comment": "Issuing a key with expiresAt in the past returns 400.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "past_expiry",
      "config": {
        "now": "2026-07-05T12:00:00Z"
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"k\",\"expiresAt\":\"2020-01-01T00:00:00Z\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalid_query_parameter"
        }
      }
    }
  ]
}
