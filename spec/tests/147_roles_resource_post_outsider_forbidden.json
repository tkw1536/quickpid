{
  "name": "147_roles_resource_post_outsider_forbidden",
  "comment": "A user with no role on a namespace cannot create resources in it (403 forbidden).",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_owner",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"owner\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "owner",
          "password": false
        }
      }
    },
    {
      "name": "create_outsider",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"outsider\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "outsider",
          "password": false
        }
      }
    },
    {
      "name": "issue_owner_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "owner-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=owner",
        "body": "{\"comment\":\"owner\",\"expires_at\":null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "owner",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "owner-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
        }
      }
    },
    {
      "name": "issue_outsider_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "outsider-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaoutsider"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=outsider",
        "body": "{\"comment\":\"outsider\",\"expires_at\":null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "outsider",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "outsider-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaoutsider"
        }
      }
    },
    {
      "name": "owner_creates_namespace",
      "config": {
        "namespaceIDs": [
          "c1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"perm-ns\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "c1000000-0000-4000-8000-000000000001",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "perm-ns"
        }
      }
    },
    {
      "name": "owner_creates_resource",
      "config": {
        "pids": [
          "aaa-bbb"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/c1000000-0000-4000-8000-000000000001/resources",
        "body": "{\"url\":\"https://example.com/existing\",\"metadata\":\"seed\",\"tags\":[\"seed\"]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "date_updated": "2020-01-02T03:04:05Z",
          "deleted": false,
          "metadata": "seed",
          "pid": "aaa-bbb",
          "url": "https://example.com/existing",
          "tags": [
            "seed"
          ]
        }
      }
    },
    {
      "name": "outsider_create_resource_forbidden",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/c1000000-0000-4000-8000-000000000001/resources",
        "body": "{\"url\":\"https://example.com/nope\",\"metadata\":\"x\",\"tags\":[\"x\"]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaoutsider"
          ]
        ]
      },
      "response": {
        "code": 403,
        "body": {
          "error": "forbidden"
        }
      }
    }
  ]
}
