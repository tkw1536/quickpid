{
  "name": "296_namespace_create_post_multi_tags_success",
  "comment": "POST /resolver/namespaces accepts multiple tags and returns them in order.",
  "steps": [
    {
      "name": "create_multi_tags",
      "config": {
        "namespaceIDs": [
          "f1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[\"alpha\",\"beta\"],\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "f1000000-0000-4000-8000-000000000001",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "alpha",
            "beta"
          ]
        }
      }
    },
    {
      "name": "filter_by_second_tag",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces?tag=beta"
      },
      "response": {
        "code": 200,
        "body": {
          "offset": 0,
          "total": 1,
          "items": [
            {
              "dateCreated": "2020-01-02T03:04:05Z",
              "dateUpdated": "2020-01-02T03:04:05Z",
              "id": "f1000000-0000-4000-8000-000000000001",
              "pidFormat": {
                "characters": "full",
                "pattern": "***-***"
              },
              "tags": [
                "alpha",
                "beta"
              ]
            }
          ]
        }
      }
    }
  ]
}
