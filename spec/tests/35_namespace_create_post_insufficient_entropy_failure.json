{
  "name": "35_namespace_create_post_insufficient_entropy_failure",
  "comment": "If namespace id generation exhausts retries, POST /resolver/namespaces returns 503 insufficient_entropy.",
  "steps": [
    {
      "name": "success",
      "config": {
        "namespaceIDs": [
          "fake-namespace-id"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"flow-tag\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "fake-namespace-id",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "flow-tag"
        }
      }
    },
    {
      "name": "insufficientEntropy_fail",
      "config": {
        "namespaceIDs": [
          "fake-namespace-id"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "limits": {
        "MaxBodyBytes": 0,
        "DefaultPageLimit": 0,
        "MaxPageLimit": 0,
        "MaxBatchItems": 0,
        "MaxNamespaceIDAttempts": 1,
        "MaxPIDAttempts": 0
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"seed-dup\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 503,
        "body": {
          "error": "insufficient_entropy"
        }
      }
    }
  ]
}
