{
  "name": "35_namespace_create_post_insufficientEntropy_failure",
  "comment": "If namespace id generation exhausts retries, POST /resolver/namespaces returns 503 insufficientEntropy.",
  "steps": [
    {
      "name": "success",
      "config": {
        "namespaceIDs": [
          "fake-namespace-id"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[\"flow-tag\"],\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "fake-namespace-id",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "flow-tag"
          ]
        }
      }
    },
    {
      "name": "insufficientEntropy_fail",
      "config": {
        "namespaceIDs": [
          "fake-namespace-id"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "limits": {
        "MaxBodyBytes": 0,
        "DefaultPageLimit": 0,
        "MaxPageLimit": 0,
        "MaxBatchItems": 0,
        "MaxNamespaceIDAttempts": 1,
        "MaxPIDAttempts": 0
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[\"seed-dup\"],\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 503,
        "body": {
          "error": "insufficientEntropy"
        }
      }
    }
  ]
}
