{
  "name": "auth_user_patch_forbidden_self",
  "comment": "Users cannot update their own account via PATCH /user/; attempting to do so returns 403 forbidden.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root"
        }
      }
    },
    {
      "name": "issue_root_key2",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "root-key-2"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaroot2"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"root\", \"expires_at\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "root",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "root-key-2",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaroot2"
        }
      }
    },
    {
      "name": "patch_self_forbidden",
      "config": {},
      "request": {
        "method": "PATCH",
        "path": "/user/?username=root",
        "body": "{\"superuser\":false}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 403,
        "body": {
          "error": "forbidden"
        }
      }
    }
  ]
}
