{
  "name": "224_auth_users_autocomplete_non_superuser_allowed",
  "comment": "Non-superusers may call GET /users/autocomplete.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice",
          "password": false
        }
      }
    },
    {
      "name": "issue_alice_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "alice-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=alice",
        "body": "{\"comment\": \"alice\",\"expiresAt\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "alice",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "alice-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        }
      }
    },
    {
      "name": "create_bob",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"bob\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "bob",
          "password": false
        }
      }
    },
    {
      "name": "autocomplete_non_superuser",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/users/autocomplete?query=al",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": [
          "alice"
        ]
      }
    }
  ]
}
