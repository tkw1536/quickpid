{
  "name": "auth_user_key_post_userNotFound",
  "comment": "POST /user/key?username=... for a non-existent user returns 401 unauthorized.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "missing_user",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"k\",\"expiresAt\":null,\"userScopes\":[],\"namespaceScopes\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "nobody"
          ]
        ]
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    }
  ]
}
