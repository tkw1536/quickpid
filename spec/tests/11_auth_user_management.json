{
  "name": "auth_user_management",
  "comment": "User and API key management routes enforce authentication and superuser rules.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root"
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice"
        }
      }
    },
    {
      "name": "issue_alice_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "alice-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"alice\", \"username\": \"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "alice",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "alice-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        }
      }
    },
    {
      "name": "verify_alice_key",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": false,
          "username": "alice"
        }
      }
    },
    {
      "name": "create_servertest",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"servertest\",\"superuser\":true}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": true,
          "username": "servertest"
        }
      }
    },
    {
      "name": "issue_servertest_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "servertest-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaservertest"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"servertest\", \"username\": \"servertest\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "servertest",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "servertest-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaservertest"
        }
      }
    },
    {
      "name": "verify_servertest_key",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaservertest"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "servertest"
        }
      }
    },
    {
      "name": "get_current_user_unauthorized",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/user/"
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    },
    {
      "name": "create_user_forbidden_non_superuser",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"bob\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 403,
        "body": {
          "error": "forbidden"
        }
      }
    },
    {
      "name": "create_user_superuser",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"bob\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaservertest"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "bob"
        }
      }
    },
    {
      "name": "create_user_invalid_username",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"BADUPPER\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaservertest"
          ]
        ]
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalid_username"
        }
      }
    },
    {
      "name": "list_users_forbidden_non_superuser",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/users/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 403,
        "body": {
          "error": "forbidden"
        }
      }
    },
    {
      "name": "list_users_superuser",
      "config": {},
      "limits": {
        "MaxBodyBytes": 1048576,
        "DefaultPageLimit": 100,
        "MaxPageLimit": 1000,
        "MaxBatchItems": 100,
        "MaxNamespaceIDAttempts": 100,
        "MaxPIDAttempts": 100
      },
      "request": {
        "method": "GET",
        "path": "/users/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaservertest"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "items": [
            {
              "superuser": false,
              "username": "alice"
            },
            {
              "superuser": false,
              "username": "bob"
            },
            {
              "superuser": true,
              "username": "root"
            },
            {
              "superuser": true,
              "username": "servertest"
            }
          ],
          "offset": 0,
          "total": 4
        }
      }
    },
    {
      "name": "issue_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "issued-key-1"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa01"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"new key\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "new key",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "issued-key-1",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa01"
        }
      }
    },
    {
      "name": "issue_key_invalid_username",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"new key\", \"username\":\"BADUPPER\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaservertest"
          ]
        ]
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalid_username"
        }
      }
    },
    {
      "name": "get_current_user_with_issued_key",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa01"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": false,
          "username": "alice"
        }
      }
    },
    {
      "name": "update_current_user_invalid_username",
      "config": {},
      "request": {
        "method": "PATCH",
        "path": "/user/",
        "body": "{\"username\":\"BADUPPER\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalid_username"
        }
      }
    },
    {
      "name": "revoke_key",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/key/revoke",
        "body": "{\"id\":\"issued-key-1\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "comment": "new key",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "issued-key-1"
        }
      }
    },
    {
      "name": "get_current_user_revoked_key",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa01"
          ]
        ]
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    }
  ]
}
