{
  "name": "117_auth_user_post_create_superuser",
  "comment": "A superuser can create another superuser account via POST /user/.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_servertest",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"servertest\",\"superuser\":true}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": true,
          "username": "servertest",
          "password": false
        }
      }
    }
  ]
}
