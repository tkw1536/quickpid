{
  "name": "anonymous_permissions_put_unavailable",
  "comment": "In anonymous mode, PUT namespace permission returns 404 anonymous_mode_unavailable.",
  "steps": [
    {
      "name": "create_namespace_anonymous",
      "config": {
        "anonymous": true,
        "namespaceIDs": [
          "d1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"anon-ns\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "d1000000-0000-4000-8000-000000000001",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "anon-ns"
        }
      }
    },
    {
      "name": "set_permission_anonymous_unavailable",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "PUT",
        "path": "/resolver/namespaces/c1000000-0000-4000-8000-000000000001/permissions/reader",
        "body": "{\"level\":\"editor\"}"
      },
      "response": {
        "code": 404,
        "body": {
          "error": "anonymous_mode_unavailable"
        }
      }
    }
  ]
}
