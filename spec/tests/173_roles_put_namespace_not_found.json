{
  "name": "roles_put_namespace_not_found",
  "comment": "PUT role on a missing namespace returns 404 namespace_not_found.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "issue_root_key2",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "root-key-2"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaroot2"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"root\", \"expiresAt\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "root",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "root-key-2",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaroot2"
        }
      }
    },
    {
      "name": "put_missing_ns",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/namespaces/missing-ns/roles/alice",
        "body": "{\"role\":\"editor\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 404,
        "body": {
          "error": "namespace_not_found"
        }
      }
    }
  ]
}
