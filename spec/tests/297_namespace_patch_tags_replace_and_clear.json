{
  "name": "297_namespace_patch_tags_replace_and_clear",
  "comment": "PATCH namespace tags replaces the full list, and an empty array clears all tags.",
  "steps": [
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "f1000000-0000-4000-8000-000000000002"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[\"one\",\"two\"],\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "f1000000-0000-4000-8000-000000000002",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "one",
            "two"
          ]
        }
      }
    },
    {
      "name": "replace_tags",
      "config": {
        "now": "2020-01-02T03:05:06Z",
        "anonymous": true
      },
      "request": {
        "method": "PATCH",
        "path": "/resolver/namespaces/f1000000-0000-4000-8000-000000000002",
        "body": "{\"tags\":[\"three\"]}"
      },
      "response": {
        "code": 200,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:05:06Z",
          "id": "f1000000-0000-4000-8000-000000000002",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "three"
          ]
        }
      }
    },
    {
      "name": "clear_tags",
      "config": {
        "now": "2020-01-02T03:06:07Z",
        "anonymous": true
      },
      "request": {
        "method": "PATCH",
        "path": "/resolver/namespaces/f1000000-0000-4000-8000-000000000002",
        "body": "{\"tags\":[]}"
      },
      "response": {
        "code": 200,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:06:07Z",
          "id": "f1000000-0000-4000-8000-000000000002",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": []
        }
      }
    }
  ]
}
