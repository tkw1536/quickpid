{
  "name": "146_roles_namespace_get_owner_allowed",
  "comment": "A user with namespace access can GET the namespace metadata.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_owner",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"owner\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "owner",
          "password": false
        }
      }
    },
    {
      "name": "create_reader",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"reader\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "reader",
          "password": false
        }
      }
    },
    {
      "name": "issue_owner_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "owner-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"owner\",\"expiresAt\":null,\"userScopes\":[],\"namespaceScopes\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "owner"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "owner",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "owner-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner",
          "userScopes": [],
          "namespaceScopes": []
        }
      }
    },
    {
      "name": "issue_reader_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "reader-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaareader"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"reader\",\"expiresAt\":null,\"userScopes\":[],\"namespaceScopes\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "reader"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "reader",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "reader-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaareader",
          "userScopes": [],
          "namespaceScopes": []
        }
      }
    },
    {
      "name": "owner_creates_namespace",
      "config": {
        "namespaceIDs": [
          "c1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[\"perm-ns\"],\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "c1000000-0000-4000-8000-000000000001",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "perm-ns"
          ]
        }
      }
    },
    {
      "name": "owner_creates_resource",
      "config": {
        "pids": [
          "aaa-bbb"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/c1000000-0000-4000-8000-000000000001/resources",
        "body": "{\"url\":\"https://example.com/existing\",\"metadata\":\"seed\",\"tags\":[\"seed\"]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "deleted": false,
          "metadata": "seed",
          "pid": "aaa-bbb",
          "url": "https://example.com/existing",
          "tags": [
            "seed"
          ]
        }
      }
    },
    {
      "name": "reader_get_namespace_forbidden",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/c1000000-0000-4000-8000-000000000001",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaareader"
          ]
        ]
      },
      "response": {
        "code": 403,
        "body": {
          "error": "forbidden"
        }
      }
    }
  ]
}
