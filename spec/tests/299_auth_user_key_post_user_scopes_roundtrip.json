{
  "name": "auth_user_key_post_user_scopes_roundtrip",
  "comment": "Issuing a key with non-empty userScopes stores and returns those scopes on issue and list.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "issue_scoped_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "scoped-user-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaascope"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\":\"user-scoped\",\"expiresAt\":null,\"userScopes\":[\"listOwnKeys\",\"getUserInfo\"],\"namespaceScopes\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "user-scoped",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "scoped-user-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaascope",
          "userScopes": [
            "listOwnKeys",
            "getUserInfo"
          ],
          "namespaceScopes": []
        }
      }
    },
    {
      "name": "list_keys",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/user/key",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaascope"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "offset": 0,
          "total": 2,
          "items": [
            {
              "comment": "bootstrap",
              "createdAt": "2026-07-05T12:00:00Z",
              "expiresAt": null,
              "id": "bootstrap",
              "userScopes": [],
              "namespaceScopes": []
            },
            {
              "comment": "user-scoped",
              "createdAt": "2026-07-05T12:00:00Z",
              "expiresAt": null,
              "id": "scoped-user-key",
              "userScopes": [
                "listOwnKeys",
                "getUserInfo"
              ],
              "namespaceScopes": []
            }
          ]
        }
      }
    }
  ]
}
