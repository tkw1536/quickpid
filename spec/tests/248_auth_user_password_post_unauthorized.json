{
  "name": "auth_user_password_post_unauthorized",
  "comment": "POST /user/password without authentication returns 401 unauthorized.",
  "steps": [
    {
      "name": "set_unauthenticated",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/password",
        "body": "{\"password\":\"secret\"}"
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    }
  ]
}
