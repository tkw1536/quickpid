{
  "name": "23_namespace_get_unauthorized",
  "comment": "In authenticated mode, GET /resolver/namespaces/{id} without credentials returns 401 unauthorized.",
  "steps": [
    {
      "name": "create_namespace_for_later_steps",
      "config": {
        "anonymous": true,
        "namespaceIDs": [
          "b1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"auth-ns\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "id": "b1000000-0000-4000-8000-000000000001",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "auth-ns"
        }
      }
    },
    {
      "name": "get_unauthenticated",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/b1000000-0000-4000-8000-000000000002"
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    }
  ]
}
