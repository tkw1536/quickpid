{
  "name": "101_namespace_get_not_found",
  "comment": "GET for a namespace id that does not exist returns 404 namespace_not_found.",
  "steps": [
    {
      "name": "not_found",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/ffffffff-ffff-ffff-ffff-ffffffffffff"
      },
      "response": {
        "code": 404,
        "body": {
          "error": "namespace_not_found"
        }
      }
    }
  ]
}
