{
  "name": "resource_list_get_invalid_limit_values",
  "comment": "Invalid limit values on resource listing return 400 invalidQueryParameter.",
  "steps": [
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "46c14e5d-c048-4159-a26a-f37bc0110c85"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"res-ns\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "46c14e5d-c048-4159-a26a-f37bc0110c85",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "res-ns"
        }
      }
    },
    {
      "name": "limit_negative",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources?limit=-1"
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalidQueryParameter"
        }
      }
    },
    {
      "name": "limit_non_integer",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources?limit=abc"
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalidQueryParameter"
        }
      }
    }
  ]
}
