{
  "name": "128_auth_user_patch_invalidUsername",
  "comment": "PATCH /user with an invalid username query parameter returns 400 invalidUsername.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice",
          "password": false
        }
      }
    },
    {
      "name": "issue_alice_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "alice-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=alice",
        "body": "{\"comment\": \"alice\",\"expiresAt\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "alice",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "alice-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        }
      }
    },
    {
      "name": "update_current_user_invalidUsername",
      "config": {},
      "request": {
        "method": "PATCH",
        "path": "/user?username=BADUPPER",
        "body": "{}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalidUsername"
        }
      }
    }
  ]
}
