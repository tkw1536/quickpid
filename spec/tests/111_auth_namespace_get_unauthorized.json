{
  "name": "111_auth_namespace_get_unauthorized",
  "comment": "In authenticated mode, getting a namespace without credentials returns 200 because the endpoint is open to all callers.",
  "steps": [
    {
      "name": "create_namespace_for_later_steps",
      "config": {
        "anonymous": true,
        "namespaceIDs": [
          "b1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[\"auth-ns\"],\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "b1000000-0000-4000-8000-000000000001",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "auth-ns"
          ]
        }
      }
    },
    {
      "name": "get_namespace_unauthenticated_ok",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/b1000000-0000-4000-8000-000000000001"
      },
      "response": {
        "code": 200,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "b1000000-0000-4000-8000-000000000001",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "auth-ns"
          ]
        }
      }
    }
  ]
}
