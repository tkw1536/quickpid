{
  "name": "auth_user_get_impersonate_unauthorized",
  "comment": "Only superusers may use the X-Impersonate-User header on GET /user/; others receive 401 unauthorized.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\": \"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice",
          "password": false
        }
      }
    },
    {
      "name": "issue_alice_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "alice-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"alice\", \"expiresAt\": null,\"userScopes\":[],\"namespaceScopes\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "alice"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "alice",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "alice-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice",
          "userScopes": [],
          "namespaceScopes": []
        }
      }
    },
    {
      "name": "forbidden_username_param",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ],
          [
            "X-Impersonate-User",
            "root"
          ]
        ]
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    }
  ]
}
