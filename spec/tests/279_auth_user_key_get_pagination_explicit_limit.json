{
  "name": "279_auth_user_key_get_pagination_explicit_limit",
  "comment": "GET /user/key applies explicit limit/offset over still-valid API keys before expiry.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\": \"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice",
          "password": false
        }
      }
    },
    {
      "name": "issue_alice_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "alice-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=alice",
        "body": "{\"comment\": \"alice\", \"expires_at\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "alice",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "alice-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        }
      }
    },
    {
      "name": "issue_temp_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "temp-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaatemp"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"temp\", \"expires_at\": \"2026-07-06T12:00:00Z\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "temp",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": "2026-07-06T12:00:00Z",
          "id": "temp-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaatemp"
        }
      }
    },
    {
      "name": "list_first_page_before_expiry",
      "config": {
        "now": "2026-07-05T12:00:00Z"
      },
      "request": {
        "method": "GET",
        "path": "/user/key?limit=1&offset=0",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "offset": 0,
          "total": 2,
          "items": [
            {
              "comment": "alice",
              "created_at": "2026-07-05T12:00:00Z",
              "expires_at": null,
              "id": "alice-key"
            }
          ]
        }
      }
    },
    {
      "name": "list_second_page_before_expiry",
      "config": {
        "now": "2026-07-05T12:00:00Z"
      },
      "request": {
        "method": "GET",
        "path": "/user/key?limit=1&offset=1",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "offset": 1,
          "total": 2,
          "items": [
            {
              "comment": "temp",
              "created_at": "2026-07-05T12:00:00Z",
              "expires_at": "2026-07-06T12:00:00Z",
              "id": "temp-key"
            }
          ]
        }
      }
    }
  ]
}
