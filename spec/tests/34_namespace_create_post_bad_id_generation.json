{
  "name": "34_namespace_create_post_badIdGeneration",
  "comment": "If namespace id generation produces an invalid id, POST /resolver/namespaces returns 500 badIdGeneration.",
  "steps": [
    {
      "name": "badIDGeneration_error",
      "config": {
        "namespaceIDs": [],
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"t\",\"pidFormat\":{\"pattern\":\"***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 500,
        "body": {
          "error": "badIdGeneration"
        }
      }
    }
  ]
}
