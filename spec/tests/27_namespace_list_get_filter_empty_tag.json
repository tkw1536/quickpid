{
  "name": "namespace_list_get_filter_empty_tag",
  "comment": "An empty tag query value (tag=) is treated as the empty string and matches namespaces whose tag is empty.",
  "steps": [
    {
      "name": "create_empty_tag",
      "config": {
        "namespaceIDs": [
          "e1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "e1000000-0000-4000-8000-000000000001",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": ""
        }
      }
    },
    {
      "name": "create_other",
      "config": {
        "namespaceIDs": [
          "e1000000-0000-4000-8000-000000000002"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"other\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "date_created": "2020-01-02T03:04:05Z",
          "id": "e1000000-0000-4000-8000-000000000002",
          "pid_format": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "other"
        }
      }
    },
    {
      "name": "filter_empty_tag",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces?tag="
