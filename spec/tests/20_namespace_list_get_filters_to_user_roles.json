{
  "name": "20_namespace_list_get_filters_to_user_roles",
  "comment": "In authenticated mode, non-superusers only see namespaces where they have a non-none role.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_admin",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"admin\",\"superuser\":true}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": true,
          "username": "admin",
          "password": false
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice",
          "password": false
        }
      }
    },
    {
      "name": "issue_admin_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "admin-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaadmin"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"admin\",\"expiresAt\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "admin"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "admin",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "admin-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaadmin"
        }
      }
    },
    {
      "name": "issue_alice_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "alice-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"alice\",\"expiresAt\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "alice"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "alice",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "alice-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
        }
      }
    },
    {
      "name": "create_ns_a",
      "config": {
        "namespaceIDs": [
          "a1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"ns-a\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "a1000000-0000-4000-8000-000000000001",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "ns-a"
        }
      }
    },
    {
      "name": "create_ns_b",
      "config": {
        "namespaceIDs": [
          "b1000000-0000-4000-8000-000000000002"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"ns-b\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "b1000000-0000-4000-8000-000000000002",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "ns-b"
        }
      }
    },
    {
      "name": "grant_admin_ns_a",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/namespaces/a1000000-0000-4000-8000-000000000001/roles/admin",
        "body": "{\"role\":\"manager\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "role": "manager",
          "username": "admin"
        }
      }
    },
    {
      "name": "grant_alice_ns_b",
      "config": {},
      "request": {
        "method": "PUT",
        "path": "/resolver/namespaces/b1000000-0000-4000-8000-000000000002/roles/alice",
        "body": "{\"role\":\"contributor\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "role": "contributor",
          "username": "alice"
        }
      }
    },
    {
      "name": "list_as_alice",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaalice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "items": [
            {
              "dateCreated": "2020-01-02T03:04:05Z",
              "dateUpdated": "2020-01-02T03:04:05Z",
              "id": "b1000000-0000-4000-8000-000000000002",
              "pidFormat": {
                "characters": "full",
                "pattern": "***-***"
              },
              "tag": "ns-b"
            }
          ],
          "offset": 0,
          "total": 1
        }
      }
    }
  ]
}
