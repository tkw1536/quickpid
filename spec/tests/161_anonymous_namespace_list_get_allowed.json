{
  "name": "161_anonymous_namespace_list_get_allowed",
  "comment": "In anonymous mode, namespaces can be listed without authentication.",
  "steps": [
    {
      "name": "create_namespace_anonymous",
      "config": {
        "anonymous": true,
        "namespaceIDs": [
          "d1000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"anon-ns\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "d1000000-0000-4000-8000-000000000001",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "anon-ns"
        }
      }
    },
    {
      "name": "list_namespaces_anonymous",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces"
      },
      "response": {
        "code": 200,
        "body": {
          "items": [
            {
              "dateCreated": "2020-01-02T03:04:05Z",
              "dateUpdated": "2020-01-02T03:04:05Z",
              "id": "d1000000-0000-4000-8000-000000000001",
              "pidFormat": {
                "characters": "full",
                "pattern": "***-***"
              },
              "tag": "anon-ns"
            }
          ],
          "offset": 0,
          "total": 1
        }
      }
    }
  ]
}
