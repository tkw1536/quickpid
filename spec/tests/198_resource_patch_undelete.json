{
  "name": "resource_patch_undelete",
  "comment": "PATCH with deleted=false restores a soft-deleted resource.",
  "steps": [
    {
      "name": "create_ns",
      "config": {
        "anonymous": true,
        "namespaceIDs": [
          "46c14e5d-c048-4159-a26a-f37bc0110c85"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"r\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "id": "46c14e5d-c048-4159-a26a-f37bc0110c85",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "r"
        }
      }
    },
    {
      "name": "create_res",
      "config": {
        "pids": [
          "xjc-cjy"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources",
        "body": "{\"url\":\"https://example.com/r\",\"metadata\":\"m\",\"tags\":[\"t\"]}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "deleted": false,
          "metadata": "m",
          "pid": "xjc-cjy",
          "url": "https://example.com/r",
          "tags": [
            "t"
          ]
        }
      }
    },
    {
      "name": "delete",
      "config": {
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "PATCH",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources/xjc-cjy",
        "body": "{\"deleted\":true}"
      },
      "response": {
        "code": 200,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "deleted": true,
          "metadata": "m",
          "pid": "xjc-cjy",
          "url": "https://example.com/r",
          "tags": [
            "t"
          ]
        }
      }
    },
    {
      "name": "undelete",
      "config": {
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "PATCH",
        "path": "/resolver/namespaces/46c14e5d-c048-4159-a26a-f37bc0110c85/resources/xjc-cjy",
        "body": "{\"deleted\":false}"
      },
      "response": {
        "code": 200,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "deleted": false,
          "metadata": "m",
          "pid": "xjc-cjy",
          "url": "https://example.com/r",
          "tags": [
            "t"
          ]
        }
