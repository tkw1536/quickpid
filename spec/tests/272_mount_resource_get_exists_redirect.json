{
  "name": "272_mount_resource_get_exists_redirect",
  "comment": "GET /resolver/mounts/{baseUri}/{pid} returns 302 with a Location header when the mounted resource exists.",
  "steps": [
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "mount-resolve-ns"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"mount-resolve\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201
      }
    },
    {
      "name": "create_resource",
      "config": {
        "pids": [
          "abc-def"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/mount-resolve-ns/resources",
        "body": "{\"url\":\"https://example.com/a\",\"metadata\":\"m\",\"tags\":[\"t\"]}"
      },
      "response": {
        "code": 201
      }
    },
    {
      "name": "put_mount",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "PUT",
        "path": "/resolver/mounts/https%3A%2F%2Fexample.com%2Fprefix%2F",
        "body": "{\"namespace\":\"mount-resolve-ns\"}"
      },
      "response": {
        "code": 200
      }
    },
    {
      "name": "resolve_resource",
      "config": {
        "anonymous": true
      },
      "request": {
        "method": "GET",
        "path": "/resolver/mounts/https%3A%2F%2Fexample.com%2Fprefix%2F/abc-def"
      },
      "response": {
        "code": 302,
        "headers": [
          [
            "Location",
            "/resolver/namespaces/mount-resolve-ns/resources/abc-def"
          ]
        ],
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "deleted": false,
          "metadata": "m",
          "pid": "abc-def",
          "url": "https://example.com/a",
          "tags": [
            "t"
          ]
        }
      }
    }
  ]
}
