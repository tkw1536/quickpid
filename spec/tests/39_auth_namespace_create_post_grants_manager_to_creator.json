{
  "name": "39_auth_namespace_create_post_grants_manager_to_creator",
  "comment": "In authenticated mode, the user who creates a namespace automatically receives manager role for it.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_owner",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"owner\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "owner",
          "password": false
        }
      }
    },
    {
      "name": "issue_owner_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "owner-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=owner",
        "body": "{\"comment\": \"owner\",\"expiresAt\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "owner",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "owner-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
        }
      }
    },
    {
      "name": "owner_creates_namespace",
      "config": {
        "namespaceIDs": [
          "c2000000-0000-4000-8000-000000000001"
        ],
        "now": "2020-01-02T03:04:05Z"
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"flow-tag\",\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "id": "c2000000-0000-4000-8000-000000000001",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tag": "flow-tag"
        }
      }
    },
    {
      "name": "owner_has_manager_role",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/c2000000-0000-4000-8000-000000000001/roles/owner",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "role": "manager",
          "username": "owner"
        }
      }
    }
  ]
}
