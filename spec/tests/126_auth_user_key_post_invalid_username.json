{
  "name": "126_auth_user_key_post_invalidUsername",
  "comment": "POST /user/key with an invalid username query parameter returns 400 invalidUsername.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_servertest",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"servertest\",\"superuser\":true}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": true,
          "username": "servertest",
          "password": false
        }
      }
    },
    {
      "name": "issue_servertest_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "servertest-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaservertest"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key?username=servertest",
        "body": "{\"comment\": \"servertest\",\"expiresAt\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "servertest",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "servertest-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaservertest"
        }
      }
    },
    {
      "name": "issue_key_invalidUsername",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/key?username=BADUPPER",
        "body": "{\"comment\": \"new key\",\"expiresAt\": null}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaservertest"
          ]
        ]
      },
      "response": {
        "code": 400,
        "body": {
          "error": "invalidUsername"
        }
      }
    }
  ]
}
