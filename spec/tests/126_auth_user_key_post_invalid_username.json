{
  "name": "126_auth_user_key_post_invalidUsername",
  "comment": "POST /user/key with an invalid X-Impersonate-User header returns 401 unauthorized.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_servertest",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"servertest\",\"superuser\":true}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": true,
          "username": "servertest",
          "password": false
        }
      }
    },
    {
      "name": "issue_servertest_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "servertest-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaservertest"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"servertest\",\"expiresAt\": null,\"userScopes\":[],\"namespaceScopes\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "servertest"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "servertest",
          "createdAt": "2026-07-05T12:00:00Z",
          "expiresAt": null,
          "id": "servertest-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaservertest",
          "userScopes": [],
          "namespaceScopes": []
        }
      }
    },
    {
      "name": "issue_key_invalidUsername",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"new key\",\"expiresAt\": null,\"userScopes\":[],\"namespaceScopes\":[]}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaservertest"
          ],
          [
            "X-Impersonate-User",
            "BADUPPER"
          ]
        ]
      },
      "response": {
        "code": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    }
  ]
}
