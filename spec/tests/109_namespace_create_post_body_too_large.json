{
  "name": "namespace_create_post_body_too_large",
  "comment": "A namespace create body exceeding max_body_bytes returns 413 body_size_exceeded.",
  "steps": [
    {
      "name": "too_large",
      "config": {
        "anonymous": true
      },
      "limits": {
        "MaxBodyBytes": 64,
        "DefaultPageLimit": 0,
        "MaxPageLimit": 0,
        "MaxBatchItems": 0,
        "MaxNamespaceIDAttempts": 0,
        "MaxPIDAttempts": 0
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tag\":\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",\"pid_format\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 413,
        "body": {
          "error": "body_size_exceeded"
        }
      }
    }
  ]
}
