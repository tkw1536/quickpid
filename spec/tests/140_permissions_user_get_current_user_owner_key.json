{
  "name": "140_permissions_user_get_current_user_owner_key",
  "comment": "140 permissions user get current user owner key",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root"
        }
      }
    },
    {
      "name": "create_owner",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/",
        "body": "{\"username\":\"owner\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "owner"
        }
      }
    },
    {
      "name": "issue_owner_key",
      "config": {
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "owner-key"
        ],
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/user/key",
        "body": "{\"comment\": \"owner\", \"username\": \"owner\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "comment": "owner",
          "created_at": "2026-07-05T12:00:00Z",
          "expires_at": null,
          "id": "owner-key",
          "key": "aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
        }
      }
    },
    {
      "name": "verify_owner_key",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/user/",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaowner"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": false,
          "username": "owner"
        }
      }
    }
  ]
}
