{
  "name": "264_auth_users_get_password_filter",
  "comment": "GET /users can filter by password status via the password query parameter.",
  "steps": [
    {
      "name": "bootstrap_root",
      "config": {
        "ensureRootUser": true,
        "apiKeys": [
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
        ],
        "now": "2026-07-05T12:00:00Z",
        "apiKeyIDs": [
          "bootstrap"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/user",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "superuser": true,
          "username": "root",
          "password": false
        }
      }
    },
    {
      "name": "create_alice",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"alice\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "alice",
          "password": false
        }
      }
    },
    {
      "name": "create_bob",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user",
        "body": "{\"username\":\"bob\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 201,
        "body": {
          "superuser": false,
          "username": "bob",
          "password": false
        }
      }
    },
    {
      "name": "set_alice_password",
      "config": {},
      "request": {
        "method": "POST",
        "path": "/user/password",
        "body": "{\"password\":\"secret\"}",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ],
          [
            "X-Impersonate-User",
            "alice"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "password": true
        }
      }
    },
    {
      "name": "list_users_with_password",
      "config": {},
      "limits": {
        "MaxBodyBytes": 1048576,
        "DefaultPageLimit": 100,
        "MaxPageLimit": 1000,
        "MaxBatchItems": 100,
        "MaxNamespaceIDAttempts": 100,
        "MaxPIDAttempts": 100
      },
      "request": {
        "method": "GET",
        "path": "/users?password=true",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "items": [
            {
              "superuser": false,
              "username": "alice",
              "password": true
            }
          ],
          "offset": 0,
          "total": 1
        }
      }
    },
    {
      "name": "list_users_without_password",
      "config": {},
      "limits": {
        "MaxBodyBytes": 1048576,
        "DefaultPageLimit": 100,
        "MaxPageLimit": 1000,
        "MaxBatchItems": 100,
        "MaxNamespaceIDAttempts": 100,
        "MaxPIDAttempts": 100
      },
      "request": {
        "method": "GET",
        "path": "/users?password=false",
        "headers": [
          [
            "Authorization",
            "Bearer aaaaaaaaaaaaaaaaaaaaaaaaaaaaroot"
          ]
        ]
      },
      "response": {
        "code": 200,
        "body": {
          "items": [
            {
              "superuser": false,
              "username": "bob",
              "password": false
            },
            {
              "superuser": true,
              "username": "root",
              "password": false
            }
          ],
          "offset": 0,
          "total": 2
        }
      }
    }
  ]
}
