{
  "name": "resource_get_unauthenticated_ok",
  "comment": "In authenticated mode, GET /resolver/namespaces/{namespace}/resources/{pid} without credentials returns the full non-deleted resource.",
  "steps": [
    {
      "name": "create_namespace",
      "config": {
        "namespaceIDs": [
          "b1000000-0000-4000-8000-000000000002"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces",
        "body": "{\"tags\":[\"res-ns\"],\"pidFormat\":{\"pattern\":\"***-***\",\"characters\":\"full\"}}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "id": "b1000000-0000-4000-8000-000000000002",
          "pidFormat": {
            "characters": "full",
            "pattern": "***-***"
          },
          "tags": [
            "res-ns"
          ]
        }
      }
    },
    {
      "name": "create_resource",
      "config": {
        "pids": [
          "aaa-bbb"
        ],
        "now": "2020-01-02T03:04:05Z",
        "anonymous": true
      },
      "request": {
        "method": "POST",
        "path": "/resolver/namespaces/b1000000-0000-4000-8000-000000000002/resources",
        "body": "{\"url\":\"https://example.com/r\",\"metadata\":\"m\",\"tags\":[\"t\"]}"
      },
      "response": {
        "code": 201,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "deleted": false,
          "metadata": "m",
          "pid": "aaa-bbb",
          "url": "https://example.com/r",
          "tags": [
            "t"
          ]
        }
      }
    },
    {
      "name": "get_unauthenticated",
      "config": {},
      "request": {
        "method": "GET",
        "path": "/resolver/namespaces/b1000000-0000-4000-8000-000000000002/resources/aaa-bbb"
      },
      "response": {
        "code": 200,
        "body": {
          "dateCreated": "2020-01-02T03:04:05Z",
          "dateUpdated": "2020-01-02T03:04:05Z",
          "deleted": false,
          "metadata": "m",
          "pid": "aaa-bbb",
          "url": "https://example.com/r",
          "tags": [
            "t"
          ]
        }
      }
    }
  ]
}
